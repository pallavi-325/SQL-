
CREATE DATABASE DEP_NEW;
USE DEP_NEW;

CREATE TABLE DEPARTMENT (
    DEP_ID INT PRIMARY KEY,
    DEP_NAME VARCHAR(50)
);

CREATE TABLE TEACHER (
    TEACHER_ID INT PRIMARY KEY,
    TEACHER_NAME VARCHAR(50) NOT NULL,
    SALARY INT,
    DEP_ID INT,
    FOREIGN KEY (DEP_ID)
        REFERENCES DEPARTMENT(DEP_ID)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);

