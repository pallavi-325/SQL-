SELECT * FROM EMPLOYEE;

SELECT *
FROM EMPLOYEE
WHERE SALARY > 50000;

SELECT DEPARTMENT, AVG(SALARY) AS AVG_SALARY
FROM EMPLOYEE
GROUP BY DEPARTMENT;

SELECT DEPARTMENT, AVG(SALARY) AS AVG_SALARY
FROM EMPLOYEE
GROUP BY DEPARTMENT
HAVING AVG(SALARY) > 50000;

SELECT DEPARTMENT, AVG(SALARY) AS AVG_SALARY
FROM EMPLOYEE
WHERE SALARY > 40000
GROUP BY DEPARTMENT
HAVING AVG(SALARY) > 50000;









