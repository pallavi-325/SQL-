CREATE DATABASE SQL_PRACTICE;
USE SQL_PRACTICE;

CREATE TABLE EMPLOYEE (
    ID INT PRIMARY KEY,
    NAME VARCHAR(50),
    DEPARTMENT VARCHAR(30),
    SALARY DECIMAL(10,2),
    AGE INT,
    CITY VARCHAR(30),
    BONUS DECIMAL(10,2)
);

