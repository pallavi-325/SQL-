SELECT * FROM EMPLOYEE;

SELECT ID , NAME FROM EMPLOYEE;

SELECT AGE 
FROM EMPLOYEE
 WHERE AGE +10 > 22 ;

 SELECT * FROM EMPLOYEE
WHERE AGE > 25 AND SALARY > 50000;


 SELECT * FROM EMPLOYEE
WHERE AGE > 25 OR SALARY > 50000;


 SELECT * FROM EMPLOYEE
WHERE AGE BETWEEN 25 AND 30;

SELECT * FROM EMPLOYEE
LIMIT 3;

SELECT * FROM EMPLOYEE
ORDER BY AGE ASC;

SELECT * FROM EMPLOYEE
ORDER BY AGE DESC;

SELECT COUNT(SALARY) 
FROM EMPLOYEE;

SELECT CITY , COUNT(CITY)
FROM EMPLOYEE
GROUP BY CITY;

SELECT CITY, AVG(SALARY) AS AVG_SALARY
FROM EMPLOYEE
GROUP BY CITY
ORDER BY CITY ASC;