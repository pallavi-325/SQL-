USE JOIN_PRACTICE;

-- FULL OUTER JOIN using UNION

SELECT
    S.ID AS STUDENT_ID,
    S.NAME,
    S.CITY,
    M.ID AS MARKS_ID,
    M.SUBJECT,
    M.MARKS
FROM STUDENT S
LEFT JOIN MARKS M
ON S.ID = M.ID

UNION

SELECT
    S.ID AS STUDENT_ID,
    S.NAME,
    S.CITY,
    M.ID AS MARKS_ID,
    M.SUBJECT,
    M.MARKS
FROM STUDENT S
RIGHT JOIN MARKS M
ON S.ID = M.ID;