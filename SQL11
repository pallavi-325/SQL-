SELECT *
FROM STUDENT
INNER JOIN MARKS
ON STUDENT.ID = MARKS.ID;

SELECT STUDENT.NAME, MARKS.SUBJECT, MARKS.MARKS
FROM STUDENT
INNER JOIN MARKS
ON STUDENT.ID = MARKS.ID;



SELECT S.NAME, M.SUBJECT, M.MARKS
FROM STUDENT S
INNER JOIN MARKS M
ON S.ID = M.ID
WHERE M.MARKS > 85;